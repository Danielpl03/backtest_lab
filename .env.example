# URL pública del backend Python desplegado en Render (sin slash final)
BACKEND_URL=https://TU-BACKEND.onrender.com

# Opcional: puerto local (Render define PORT automáticamente)
PORT=3000

# Opcional: ruta para persistir sesiones
# SESSIONS_FILE=/ruta/persistente/sessions.json

# Si configuraste BACKTEST_API_KEY en el backend, usa aquí el mismo valor.
BACKEND_API_KEY=
